# ---------------------------------------------------------------------------
# Keylo backend local-development template.
# Copy this file to `.env` and replace every placeholder value before use.
# Never commit the resulting `.env` file.
# ---------------------------------------------------------------------------

APP_NAME=Keylo API
ENVIRONMENT=development
API_VERSION=v1
DEBUG=true
LOG_LEVEL=INFO

# SQLAlchemy URL. Keep the password URL-encoded if it contains special chars.
DATABASE_URL=postgresql+psycopg2://keylo:change-me-local-dev@localhost:5432/keylo_db

# JSON list (or comma-separated list) of allowed browser origins.
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Used by docker-compose.yml. POSTGRES_PASSWORD must match DATABASE_URL.
POSTGRES_DB=keylo_db
POSTGRES_USER=keylo
POSTGRES_PASSWORD=change-me-local-dev
POSTGRES_PORT=5432
